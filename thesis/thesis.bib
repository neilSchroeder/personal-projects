@article{LONGO1975283,
title = {Monte Carlo calculation of photon-initiated electromagnetic showers in lead glass},
journal = {Nuclear Instruments and Methods},
volume = {128},
number = {2},
pages = {283-307},
year = {1975},
issn = {0029-554X},
doi = {https://doi.org/10.1016/0029-554X(75)90679-5},
url = {https://www.sciencedirect.com/science/article/pii/0029554X75906795},
author = {Egidio Longo and Ignazio Sestili},
abstract = {We present the results of a Monte Carlo calculation of the longitudinal and lateral development of photon-initiated electron-photon cascades in SF5 lead glass for the following energies of the primary photon: 100, 300, 500, 700, 1000, and 5000 MeV. The longitudinal development has been carefully treated and a satisfactory analytical representation is suggested as a convenient tool for many practical problems. The lateral spread has been analyzed and estimated from different points of view. Fluctuations obtained from the Monte Carlo calculation for the track length of showers within 5, 10 and 15X0 of SF5 are presented. They have also been obtained for an array of 9 counters - each 1×X0 thick - placed one behind the other. These results have been interpolated rather accurately with a Polya distribution for a convenient set of values of the corresponding parameters.}
}

