; Engine configuration file.
; Keep edits minimal and use the Godot editor when available.

config_version=5

[application]

config/name="VoidGrit"
run/main_scene="res://scenes/gameplay/level_1.tscn"
config/features=PackedStringArray("4.4", "Mobile")

[autoload]

GameManager="*res://common/game_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[input_devices/pointing]

emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
